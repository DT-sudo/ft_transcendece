# ---------------------------------------------------------------------------
# PlanShift environment template
#
# Copy this file to `.env` and adjust the values. `.env` is ignored by Git and
# by Docker, and must never be committed — it is where real credentials live.
#
#   cp .env.example .env
#
# `backend/config/env.py` loads this file at startup. Real environment
# variables (shell exports, docker compose `environment:`) always take
# priority over what is written here.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate a fresh key for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-me

# 1 = verbose errors + auto-reload. Must be 0 for anything reachable by others.
DEBUG=0

# Comma-separated hostnames Django will answer for.
# `web` is the service name the nginx proxy uses on the compose network.
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Origins allowed to POST (scheme + host + port). Must match how you browse.
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

TIME_ZONE=Europe/Prague

# --- Database ---------------------------------------------------------------
# SQLite by default. For PostgreSQL:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=planshift
#   DB_USER=planshift
#   DB_PASSWORD=change-me
#   DB_HOST=db
#   DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- TLS / proxy ------------------------------------------------------------
# nginx terminates TLS and is the only service that publishes a port; Django
# is reachable solely on the internal compose network.

# Send session and CSRF cookies over HTTPS only. Leave at 1.
SECURE_COOKIES=1

# Ports the nginx terminator is published on. HTTP_PORT only issues a 301 to
# HTTPS_PORT; it never serves content.
HTTPS_PORT=8443
HTTP_PORT=8080

# How long browsers should refuse plain HTTP for this host (applied when
# DEBUG=0 only, so a misconfigured dev box cannot pin itself to HTTPS).
SECURE_HSTS_SECONDS=31536000

# --- Demo data --------------------------------------------------------------
# Seed demo positions, staff and shifts on container start.
SEED_DEMO_DATA=1

# Expose the one-click "Demo: Manager / Employee" buttons on the login page.
# These skip password entry, so turn this off for any real deployment.
# Defaults to the value of DEBUG.
ENABLE_DEMO_LOGIN=1

# --- Live updates -----------------------------------------------------------
# Redis channel layer that carries WebSocket broadcasts. docker compose points
# this at its own redis service. Leave empty for a local `runserver`, which
# then uses an in-process layer.
REDIS_URL=
