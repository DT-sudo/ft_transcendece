# ---------------------------------------------------------------------------
# PlanShift environment template
#
# Copy this file to `.env` and adjust the values. `.env` is ignored by Git and
# must never be committed — it is where real credentials live.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Generate a fresh key for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-me

# 1 = verbose errors + auto-reload. Must be 0 for anything reachable by others.
DEBUG=0

# Comma-separated hostnames Django will answer for.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to POST (scheme + host + port). Must match how you browse.
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

TIME_ZONE=Europe/Prague

# --- Database ---------------------------------------------------------------
# SQLite by default. For PostgreSQL:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=planshift
#   DB_USER=planshift
#   DB_PASSWORD=change-me
#   DB_HOST=db
#   DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- TLS / proxy ------------------------------------------------------------
# Send session and CSRF cookies over HTTPS only. Defaults to "not DEBUG".
SECURE_COOKIES=1

# Port the nginx TLS terminator is published on (used for the HTTP->HTTPS
# redirect and referenced by CSRF_TRUSTED_ORIGINS above).
HTTPS_PORT=8443
HTTP_PORT=8080

# --- Demo data --------------------------------------------------------------
# Seed demo positions, staff and shifts on container start.
SEED_DEMO_DATA=1

# Expose the one-click "Demo: Manager / Employee" buttons on the login page.
# Turn this off for a real deployment. Defaults to the value of DEBUG.
ENABLE_DEMO_LOGIN=1
