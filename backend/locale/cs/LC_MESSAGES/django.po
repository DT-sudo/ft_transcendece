msgid "Two-factor authentication turned on"
msgstr "Dvoufázové ověření zapnuto"

msgid ""
"Signing in to your account now also takes a code from your authenticator app."
msgstr "Přihlášení k vašemu účtu teď vyžaduje také kód z ověřovací aplikace."

msgid "New recovery codes created"
msgstr "Vytvořeny nové záložní kódy"

msgid ""
"New recovery codes were created for your account. The old ones no longer "
"work."
msgstr "Pro váš účet byly vytvořeny nové záložní kódy. Staré už neplatí."

msgid "Two-factor authentication turned off"
msgstr "Dvoufázové ověření vypnuto"

msgid "Signing in to your account no longer takes a code."
msgstr "Přihlášení k vašemu účtu už nevyžaduje kód."

msgid "Two-factor authentication reset"
msgstr "Dvoufázové ověření zrušeno"

#, python-format
msgid ""
"%(by)s turned off two-factor authentication for your account. Turn it on "
"again in Account settings."
msgstr ""
"%(by)s vypnul(a) dvoufázové ověření vašeho účtu. Znovu ho zapnete v "
"Nastavení účtu."

msgid "Your PlanShift data export"
msgstr "Export vašich údajů z PlanShiftu"

#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"A copy of your personal data was just downloaded from your PlanShift account "
"(%(when)s).\n"
"\n"
"If this wasn't you, someone else may have access to your account - sign in "
"and change your password, or contact your manager immediately.\n"
"\n"
"— PlanShift"
msgstr ""
"Dobrý den, %(name)s,\n"
"\n"
"z vašeho účtu PlanShift byla právě stažena kopie vašich osobních údajů "
"(%(when)s).\n"
"\n"
"Pokud jste to nebyli vy, může mít k vašemu účtu přístup někdo jiný – "
"přihlaste se a změňte si heslo, nebo okamžitě kontaktujte svého manažera.\n"
"\n"
"— PlanShift"

msgid "Your PlanShift account has been deleted"
msgstr "Váš účet PlanShift byl smazán"

#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"Your PlanShift account and the personal data associated with it (profile, "
"shift assignments and unavailability) have been permanently deleted, as you "
"requested.\n"
"\n"
"If you did not request this, contact your organisation's manager "
"immediately.\n"
"\n"
"— PlanShift"
msgstr ""
"Dobrý den, %(name)s,\n"
"\n"
"váš účet PlanShift a osobní údaje s ním spojené (profil, přiřazení ke směnám "
"a nedostupnost) byly na vaši žádost trvale smazány.\n"
"\n"
"Pokud jste o to nežádali, okamžitě kontaktujte manažera své organizace.\n"
"\n"
"— PlanShift"

msgid "uploaded (stored as a 256x256 WebP)"
msgstr "nahrána (uložena jako WebP 256×256)"

msgid "Privacy & My Data"
msgstr "Soukromí a moje údaje"

msgid "Email or password didn't match - account not deleted."
msgstr "E-mail nebo heslo nesouhlasí – účet nebyl smazán."

msgid "Your account and all associated data have been deleted."
msgstr "Váš účet a všechny související údaje byly smazány."

msgid "Enter your current password to change your email."
msgstr "Pro změnu e-mailu zadejte své současné heslo."

msgid "Choose a picture to upload."
msgstr "Vyberte obrázek k nahrání."

msgid "That file isn't a picture we can read. Use JPEG, PNG, WebP or GIF."
msgstr ""
"Tento soubor není obrázek, který umíme přečíst. Použijte JPEG, PNG, WebP "
"nebo GIF."

#, python-format
msgid "The picture must be %(size)d MB or smaller."
msgstr "Obrázek může mít nejvýše %(size)d MB."

msgid "Use a JPEG, PNG, WebP or GIF picture."
msgstr "Použijte obrázek ve formátu JPEG, PNG, WebP nebo GIF."

#, python-format
msgid "The picture must be at most %(pixels)d pixels on each side."
msgstr "Obrázek může mít na každé straně nejvýše %(pixels)d pixelů."

msgid "You can't add yourself as a friend."
msgstr "Nemůžete si přidat mezi přátele sami sebe."

#, python-format
msgid "You and %(name)s are already friends."
msgstr "S uživatelem %(name)s už jste přátelé."

#, python-format
msgid "You already sent %(name)s a friend request."
msgstr "Uživateli %(name)s jste už žádost o přátelství poslali."

#, python-format
msgid "Removed %(name)s from your friends."
msgstr "Uživatel %(name)s byl odebrán z vašich přátel."

#, python-format
msgid "Declined %(name)s's friend request."
msgstr "Žádost o přátelství od uživatele %(name)s byla odmítnuta."

#, python-format
msgid "Cancelled your friend request to %(name)s."
msgstr "Vaše žádost o přátelství pro uživatele %(name)s byla zrušena."

msgid "Profile updated."
msgstr "Profil byl upraven."

msgid "Password changed."
msgstr "Heslo bylo změněno."

msgid "Profile picture updated."
msgstr "Profilová fotografie byla změněna."

msgid "Profile picture removed."
msgstr "Profilová fotografie byla odstraněna."

