msgstr "Nastavení účtu"

msgid "Friends"
msgstr "Přátelé"

msgid "That person was not found."
msgstr "Tato osoba nebyla nalezena."

#, python-format
msgid "You and %(name)s are now friends."
msgstr "S uživatelem %(name)s jste teď přátelé."

#, python-format
msgid "Friend request sent to %(name)s."
msgstr "Žádost o přátelství byla odeslána uživateli %(name)s."

msgid "Draft"
msgstr "Koncept"

msgid "Published"
msgstr "Zveřejněno"

msgid "End time must be after start time."
msgstr "Konec musí být později než začátek."

msgid "Capacity must be at least 1."
msgstr "Kapacita musí být alespoň 1."

msgid "Selected employees must match the shift position."
msgstr "Vybraní zaměstnanci musí odpovídat pozici směny."

msgid "Cannot assign more employees than shift capacity."
msgstr "Nelze přiřadit více zaměstnanců, než je kapacita směny."

#, python-format
msgid "Employee is unavailable on %(day)s."
msgstr "Zaměstnanec není k dispozici: %(day)s."

#, python-format
msgid "Employee already assigned to: %(position)s %(start)s–%(end)s (%(day)s)"
msgstr ""
"Zaměstnanec je už přiřazen ke směně: %(position)s %(start)s–%(end)s (%(day)s)"

msgid ""
"Someone else changed this shift while you were editing it. Your changes were "
"not saved."
msgstr "Tuto směnu mezitím změnil někdo jiný. Vaše změny nebyly uloženy."

msgid "Please check the form fields."
msgstr "Zkontrolujte prosím pole formuláře."

msgid "Shift Management"
msgstr "Správa směn"

msgid "Shift updated."
msgstr "Směna byla upravena."

msgid "Shift deleted."
msgstr "Směna byla smazána."

msgid "Shift published."
msgstr "Směna byla zveřejněna."

#, python-format
msgid "Published %(count)d shift."
msgid_plural "Published %(count)d shifts."
msgstr[0] "Zveřejněna %(count)d směna."
msgstr[1] "Zveřejněny %(count)d směny."
msgstr[2] "Zveřejněno %(count)d směny."
msgstr[3] "Zveřejněno %(count)d směn."

msgid "No draft shifts to publish."
msgstr "Žádné koncepty směn ke zveřejnění."

msgid "Search Shifts"
msgstr "Hledání směn"

msgid "Workforce Analytics"
msgstr "Analýza pracovníků"

msgid "Date"
msgstr "Datum"

msgid "Start"
msgstr "Začátek"

msgid "End"
msgstr "Konec"

msgid "Position"
msgstr "Pozice"

msgid "Status"
msgstr "Stav"

msgid "Capacity"
msgstr "Kapacita"

msgid "Assigned"
msgstr "Přiřazeno"

msgid "Worker hours"
msgstr "Hodiny pracovníků"

msgid "Workers"
msgstr "Pracovníci"

msgid "My Shifts"
msgstr "Moje směny"

msgid "Enter a valid date."
msgstr "Zadejte platné datum."

msgid "Only dates from tomorrow onwards can be marked as unavailable."
msgstr "Jako nedostupné lze označit jen dny od zítřka."

msgid "You have a shift assigned on this day."
msgstr "Na tento den máte přiřazenou směnu."

msgid "Enter the code from your authenticator app, or a recovery code."
msgstr "Zadejte kód z ověřovací aplikace nebo záložní kód."

msgid "Enter the 6-digit code your app shows."
msgstr "Zadejte šestimístný kód, který zobrazuje vaše aplikace."

msgid ""
"That code doesn't match. Check that your phone's clock is set automatically, "
"then try the new code."
msgstr ""
"Kód nesouhlasí. Zkontrolujte, zda se čas v telefonu nastavuje automaticky, a "
"zkuste nový kód."

msgid "Enter your password."
msgstr "Zadejte své heslo."

msgid "Enter a code from your app, or a recovery code."
msgstr "Zadejte kód z aplikace nebo záložní kód."

msgid "Your password is incorrect."
msgstr "Vaše heslo je nesprávné."

msgid "That code is not valid."
msgstr "Tento kód není platný."

msgid "Too many incorrect codes. Wait 5 minutes, then try again."
msgstr "Příliš mnoho chybných kódů. Počkejte 5 minut a zkuste to znovu."

#, python-format
msgid "PlanShift: %(title)s"
msgstr "PlanShift: %(title)s"

#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"%(detail)s\n"
"\n"
"If this wasn't you or someone you asked, change your password and contact "
"your manager straight away.\n"
"\n"
"— PlanShift"
msgstr ""
"Dobrý den, %(name)s,\n"
"\n"
"%(detail)s\n"
"\n"
"Pokud jste to nebyli vy ani nikdo, koho jste o to požádali, změňte si heslo "
"a ihned kontaktujte svého manažera.\n"
"\n"
"— PlanShift"

msgid "Your sign-in timed out. Enter your password again."
msgstr "Vaše přihlášení vypršelo. Zadejte znovu heslo."

#, python-format
msgid ""
"You signed in with a recovery code, which now no longer works. %(count)d "
"left: get new ones in Account settings if you're running out."
msgid_plural ""
"You signed in with a recovery code, which now no longer works. %(count)d "
"left: get new ones in Account settings if you're running out."
msgstr[0] ""
"Přihlásili jste se záložním kódem, který už neplatí. Zbývá %(count)d kód. "
"Pokud vám docházejí, vytvořte si nové v Nastavení účtu."
msgstr[1] ""
"Přihlásili jste se záložním kódem, který už neplatí. Zbývají %(count)d kódy. "
"Pokud vám docházejí, vytvořte si nové v Nastavení účtu."
msgstr[2] ""
"Přihlásili jste se záložním kódem, který už neplatí. Zbývá %(count)d kódu. "
"Pokud vám docházejí, vytvořte si nové v Nastavení účtu."
msgstr[3] ""
"Přihlásili jste se záložním kódem, který už neplatí. Zbývá %(count)d kódů. "
"Pokud vám docházejí, vytvořte si nové v Nastavení účtu."

msgid "That code is not valid. Try again."
msgstr "Tento kód není platný. Zkuste to znovu."

msgid "Two-factor authentication"
msgstr "Dvoufázové ověření"

msgid "Two-factor authentication is on."
msgstr "Dvoufázové ověření je zapnuté."

msgid "Two-factor authentication is off."
msgstr "Dvoufázové ověření je vypnuté."

msgid "New recovery codes created. The old ones no longer work."
msgstr "Byly vytvořeny nové záložní kódy. Staré už neplatí."
