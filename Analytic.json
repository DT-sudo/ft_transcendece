flowchart TD

subgraph group_edge["Edge runtime"]
  node_nginx{{"nginx TLS proxy<br/>reverse proxy"}}
  node_docker["Docker deployment<br/>container topology<br/>[docker-compose.yml]"]
  node_entrypoint["Application entrypoint<br/>startup script<br/>[entrypoint.sh]"]
end

subgraph group_server["Django application"]
  node_django["Django and Channels<br/>application runtime<br/>[asgi.py]"]
  node_routes["Django routes<br/>URL routing<br/>[urls.py]"]
  node_shell["React HTML shell<br/>render boundary<br/>[shell.py]"]
  node_accounts["Accounts and roles<br/>identity domain<br/>[models.py]"]
  node_account_views["Account flows<br/>Django views<br/>[views.py]"]
  node_twofactor["TOTP 2FA<br/>security service<br/>[services.py]"]
  node_scheduling_models["Scheduling domain<br/>ORM models<br/>[models.py]"]
  node_scheduling_service["Scheduling rule engine<br/>transactional service<br/>[services.py]"]
  node_scheduling_views["Schedule form views<br/>Django views<br/>[views.py]"]
  node_privacy_legal["Privacy and legal<br/>server content flows<br/>[views.py]"]
end

subgraph group_client["React client"]
  node_react_main["React page selector<br/>SPA entry point<br/>[main.jsx]"]
  node_http_forms["CSRF form client<br/>HTTP integration<br/>[http.js]"]
  node_manager_calendar["Manager calendar<br/>React page"]
  node_employee_calendar["Employee shifts<br/>React page"]
  node_search_analytics["Search and analytics<br/>React pages"]
  node_localization["Localization<br/>locale coordination<br/>[index.js]"]
  node_live_client["Live updates and notifications<br/>browser realtime state<br/>[live.js]"]
end

subgraph group_state["Data and realtime"]
  node_database[("ORM database<br/>persistent storage")]
  node_events["Schedule events<br/>commit event dispatcher<br/>[events.py]"]
  node_channels["Manager WebSocket consumer<br/>Channels consumer<br/>[consumers.py]"]
  node_redis["Redis channel layer<br/>message backend"]
end

node_docker -->|"starts"| node_entrypoint
node_entrypoint -->|"runs"| node_django
node_nginx -->|"proxies HTTP/WebSockets"| node_django
node_django -->|"resolves requests"| node_routes
node_routes -->|"renders page shell"| node_shell
node_shell -->|"serves payload and UI shell"| node_react_main
node_react_main -->|"mounts manager page"| node_manager_calendar
node_react_main -->|"mounts employee page"| node_employee_calendar
node_react_main -->|"mounts reporting pages"| node_search_analytics
node_react_main -->|"loads client catalogs"| node_localization
node_http_forms -->|"CSRF form POSTs"| node_scheduling_views
node_scheduling_views -->|"delegates mutations"| node_scheduling_service
node_scheduling_service -->|"applies domain rules"| node_scheduling_models
node_scheduling_models -->|"persists through ORM"| node_database
node_scheduling_service -->|"dispatches after commit"| node_events
node_events -->|"publishes schedule changes"| node_channels
node_channels -.->|"uses configured channel layer"| node_redis
node_channels -->|"pushes manager updates"| node_live_client
node_live_client -->|"patches availability"| node_manager_calendar
node_live_client -->|"refreshes analytics"| node_search_analytics
node_account_views -->|"manages accounts"| node_accounts
node_account_views -->|"uses optional verification"| node_twofactor
node_accounts -->|"stores users and language"| node_database
node_privacy_legal -->|"exports or deletes account data"| node_accounts

